# Copy to .env.local and fill in. Never commit real values.

# Supabase (Live Mode: classes, students, answers). Server-only.
SUPABASE_URL=https://segvfwkcwqctbsjqmkkj.supabase.co
# Supabase dashboard → Project "patch" → Project Settings → API Keys → Secret keys (starts with sb_secret_)
SUPABASE_SECRET_KEY=

# Gemini (the /learn "Study your notes" feature). Server-only. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: extra keys from OTHER Google projects, comma-separated (each adds free daily quota)
GEMINI_API_KEYS=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=

# Optional limits for AI generation on the public site
GEMINI_DAILY_LIMIT_PER_VISITOR=50
GEMINI_DAILY_LIMIT_TOTAL=100
